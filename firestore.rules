rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL (RBAC) & SECURITY
    // ──────────────────────────────────────────────────────────────────────────
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && (getUserRole() == 'admin');
    }

    function isHOD() {
      return isSignedIn() && (getUserRole() == 'hod');
    }

    function isStaff() {
      return isSignedIn() && (getUserRole() == 'staff' || getUserRole() == 'advisor' || isHOD() || isAdmin());
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPublished(docData) {
      return docData.status == 'published' || docData.status == 'Published';
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 1. SYLLABI COLLECTION (CURRENT, PREVIOUS, FUTURE & DRAFT SECURITY)
    // ──────────────────────────────────────────────────────────────────────────
    match /syllabi/{syllabusId} {
      // HOD and Admin have full control (create, update, delete)
      allow create, update, delete, write: if isHOD() || isAdmin();

      // Read rules:
      // - HOD and Admin can read ALL records (Current, Previous, Future, Draft, Published)
      // - Students & Staff can ONLY read records where:
      //   1. status == 'published'
      //   2. effectiveStartYear <= student's applicable academic year
      //   (Future & Draft syllabus records are strictly BLOCKED at the database level)
      allow read: if isSignedIn() && (
        isHOD() || 
        isAdmin() || 
        (
          isPublished(resource.data) &&
          (
            !('effectiveStartYear' in resource.data) ||
            !('effectiveStartYear' in request.auth.token) ||
            resource.data.effectiveStartYear <= request.auth.token.effectiveStartYear
          )
        )
      );
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 2. USERS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isStaff();
      allow delete: if isAdmin();

      // User Notification Sub-collection
      match /notifications/{notifId} {
        allow read, write: if isOwner(userId) || isStaff();
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 3. STUDENTS & STUDENT PROFILES COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(studentId) || isStaff();
      allow delete: if isAdmin() || isHOD();
    }

    match /student_profiles/{profileId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(profileId) || isStaff();
      allow delete: if isAdmin() || isHOD();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 4. HACKATHONS & REGISTRATIONS COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /hackathons/{hackathonId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();

      match /teams/{teamId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /hackathonRegistrations/{regId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 5. CERTIFICATIONS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /certifications/{certId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 6. OFFICIAL ANNOUNCEMENTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 7. CAMPUS EVENTS & FESTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 8. ACADEMIC SCHEDULES & CALENDARS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /academicSchedules/{scheduleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHOD() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 9. FEES & PAYMENT RECEIPTS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /fees/{feeId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.studentId) ||
        isStaff() ||
        getUserRole() == 'parent'
      );
      allow create, update, delete: if isHOD() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 10. NOTIFICATION ENGINE COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /notification_recipients/{recipId} {
      allow read, write: if isSignedIn();
    }

    match /notification_delivery_logs/{logId} {
      allow read, write: if isStaff();
    }

    match /notification_rules/{ruleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHOD() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 11. AUDIT & ACTIVITY LOGS COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 12. ACADEMIC RECORDS & INTERNAL MARKS (MULTI-TENANT HIERARCHY)
    // ──────────────────────────────────────────────────────────────────────────
    match /institutions/{institutionId}/students/{studentId}/academic_records/{recordId} {
      // Students can read their own records, Parents can read, Staff/HOD/Admin can read
      allow read: if isSignedIn() && (
        isOwner(studentId) ||
        isStaff() ||
        getUserRole() == 'parent'
      );
      // Only Faculty, Staff, HOD, and Admin can write or update academic marks
      allow create, update, delete: if isStaff() || isHOD() || isAdmin();
    }

    match /academic_performance/{studentId} {
      allow read: if isSignedIn() && (
        isOwner(studentId) ||
        isStaff() ||
        getUserRole() == 'parent'
      );
      allow create, update, delete: if isStaff() || isHOD() || isAdmin();
    }

    match /marks/{markId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff() || isHOD() || isAdmin();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff() || isHOD() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 13. STAFF & STAFF ASSIGNMENTS COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(staffId) || isHOD() || isAdmin();
      allow delete: if isAdmin() || isHOD();
    }

    match /staffAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isHOD() || isAdmin();
    }

    // Default Fallback: Authenticated access required
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
