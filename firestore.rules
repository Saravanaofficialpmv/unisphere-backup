rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS FOR ROLE-BASED ACCESS CONTROL (RBAC) & SECURITY
    // ──────────────────────────────────────────────────────────────────────────
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return (request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid)))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role 
        : ((request.auth != null && request.auth.token != null && 'role' in request.auth.token) ? request.auth.token.role : '');
    }

    function isAdmin() {
      return isSignedIn() && (
        getUserRole() == 'admin' ||
        (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.matches('(?i).*admin.*'))
      );
    }

    function isHOD() {
      return isSignedIn() && (
        getUserRole() == 'hod' ||
        isAdmin() ||
        (request.auth.token != null && request.auth.token.email != null && request.auth.token.email.matches('(?i).*hod.*'))
      );
    }

    function isStaff() {
      return isSignedIn() && (
        getUserRole() == 'staff' || 
        getUserRole() == 'advisor' || 
        isHOD() || 
        isAdmin() ||
        (request.auth.token != null && request.auth.token.email != null && (
          request.auth.token.email.matches('(?i).*staff.*') ||
          request.auth.token.email.matches('(?i).*faculty.*') ||
          request.auth.token.email.matches('(?i).*care@gmail\\.com')
        ))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 1. SYLLABI COLLECTION
    // ──────────────────────────────────────────────────────────────────────────
    match /syllabi/{syllabusId} {
      allow read: if true;
      allow write: if isStaff() || isHOD() || isAdmin();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 2. USERS & PROFILES COLLECTIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isAdmin();

      match /notifications/{notifId} {
        allow read, write: if true;
      }
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isStaff();
    }

    match /student_profiles/{profileId} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isStaff();
    }

    match /student_profile_drafts/{draftId} {
      allow read, write: if isSignedIn();
    }

    match /profile_edit_requests/{reqId} {
      allow read, write: if isSignedIn();
    }

    match /parents/{parentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 3. HACKATHONS, TEAMS & REGISTRATIONS
    // ──────────────────────────────────────────────────────────────────────────
    match /hackathons/{hackathonId} {
      allow read: if true;
      allow write: if isStaff();

      match /{allSub=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    match /hackathon_banners/{bannerId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /hackathon_registrations/{regId} {
      allow read, write: if isSignedIn();
    }

    match /hackathonRegistrations/{regId} {
      allow read, write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 4. CERTIFICATIONS & NPTEL
    // ──────────────────────────────────────────────────────────────────────────
    match /certifications/{certId} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isStaff();
    }

    match /nptel_certificates/{certId} {
      allow read: if true;
      allow create, update, write: if isSignedIn();
      allow delete: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 5. OFFICIAL ANNOUNCEMENTS & EVENTS
    // ──────────────────────────────────────────────────────────────────────────
    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete, write: if isSignedIn();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete, write: if isStaff();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 6. ACADEMIC SCHEDULES, TIMETABLES, ATTENDANCE & MARKS
    // ──────────────────────────────────────────────────────────────────────────
    match /academicSchedules/{scheduleId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /fees/{feeId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /institutions/{institutionId}/students/{studentId}/academic_records/{recordId} {
      allow read: if true;
      allow write: if isStaff() || isSignedIn();
    }

    match /academic_performance/{studentId} {
      allow read: if true;
      allow write: if isStaff() || isSignedIn();
    }

    match /marks_documents/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /marks/{markId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /attendance_configs/{cfgId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /timetables/{timetableId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /assignments/{assignmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /submissions/{subId} {
      allow read, write: if isSignedIn();
    }

    match /exams/{examId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /projects/{projId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 7. NOTIFICATION ENGINE COLLECTIONS (Resilient for Scheduled Tasks)
    // ──────────────────────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, write: if true;
    }

    match /notification_recipients/{recipId} {
      allow read, write: if true;
    }

    match /notification_delivery_logs/{logId} {
      allow read, write: if true;
    }

    match /notification_rules/{ruleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 8. AUDIT & ACTIVITY LOGS
    // ──────────────────────────────────────────────────────────────────────────
    match /activityLogs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /audit_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 9. STAFF, FACULTY & DEPARTMENTS
    // ──────────────────────────────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /faculty/{facultyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /staffAssignments/{assignmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{allSub=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 10. LEAVE & ON-DUTY (OD) REQUESTS
    // ──────────────────────────────────────────────────────────────────────────
    match /leave_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /leave_applications/{leaveId} {
      allow read, write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 11. CAMPUS PHOTO GALLERY
    // ──────────────────────────────────────────────────────────────────────────
    match /photo_albums/{albumId} {
      allow read: if true;
      allow write: if isSignedIn();

      match /{allSub=**} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }

    // ──────────────────────────────────────────────────────────────────────────
    // 12. MULTI-TENANT & SYSTEM SETTINGS CONFIGURATION
    // ──────────────────────────────────────────────────────────────────────────
    match /public_tenants/{slug} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /institutions/{institutionId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /system_settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ──────────────────────────────────────────────────────────────────────────
    // GLOBAL FALLBACK RULE
    // ──────────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
